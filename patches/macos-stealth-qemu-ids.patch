diff --git a/hw/arm/virt-acpi-build.c b/hw/arm/virt-acpi-build.c
index d368913..a9e0e28 100644
--- a/hw/arm/virt-acpi-build.c
+++ b/hw/arm/virt-acpi-build.c
@@ -1228,7 +1228,11 @@ build_dsdt(GArray *table_data, BIOSLinker *linker, VirtMachineState *vms)
     if (vmc->acpi_expose_flash) {
         acpi_dsdt_add_flash(scope, &memmap[VIRT_FLASH]);
     }
-    fw_cfg_acpi_dsdt_add(scope, &memmap[VIRT_FW_CFG]);
+    /*
+     * Do not expose the QEMU0002 fw_cfg ACPI device to the guest.  Firmware
+     * still uses fw_cfg for boot, but the runtime guest has no driver and the
+     * ACPI namespace identifier is a strong QEMU fingerprint.
+     */
     virtio_acpi_dsdt_add(scope, memmap[VIRT_MMIO].base, memmap[VIRT_MMIO].size,
                          (irqmap[VIRT_MMIO] + ARM_SPI_BASE),
                          0, vms->virtio_transports);
